# ==============================================================================
# RibinaMart Environment Configuration Template
# Anna University R2025 Semester 3 Capstone Platform
# ==============================================================================

# Server Port (Default is 8085 to avoid conflicts on 8080)
PORT=8085

# Database Configuration (H2 Persistent File Database)
DB_URL=jdbc:h2:./data/ribinamart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=

# Production RDBMS Option (e.g., PostgreSQL / MySQL)
# DB_URL=jdbc:postgresql://localhost:5432/ribinamart
# DB_USER=postgres
# DB_PASSWORD=your_secure_password

# Google Gemini AI Integration (Optional for Live AI; falls back to Mock provider if blank)
GEMINI_API_KEY=

# Application Environment Mode (development / staging / production)
APP_ENV=development
